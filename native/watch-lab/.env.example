# Copy to .env (gitignored). Never commit real values.
# Bluetooth address of the watch, e.g. AA:BB:CC:DD:EE:FF (`python lab.py scan` finds it)
WATCH_ADDRESS=
# 32 hex chars, the Xiaomi auth key from Gadgetbridge's server-pairing flow
WATCH_AUTH_KEY=
# Supabase project URL and anon key, for `upload`
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Shared secret the health_ingest RPC checks
HEALTH_TOKEN=
# Body profile for scale body-composition maths
PROFILE_HEIGHT_CM=
PROFILE_BIRTH_DATE=
PROFILE_SEX=
